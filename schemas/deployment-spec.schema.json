{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deployment-spec.schema.json",
  "title": "Agent2 ② deployment-spec.generated.json — deployment model in the design's own wording",
  "type": "object",
  "required": ["schemaVersion", "project", "target", "resources"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "project": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object",
      "required": ["scope", "subscriptionId", "location"],
      "additionalProperties": false,
      "properties": {
        "scope": { "$ref": "#/$defs/rawField" },
        "subscriptionId": { "$ref": "#/$defs/rawField" },
        "resourceGroup": { "$ref": "#/$defs/rawField" },
        "location": { "$ref": "#/$defs/rawField" }
      }
    },
    "tags": { "type": "object", "additionalProperties": { "$ref": "#/$defs/rawField" } },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "logicalName", "settings"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^R-[0-9]{3,}$" },
          "type": { "type": "string", "description": "Azure resource type, e.g. Microsoft.Web/sites" },
          "logicalName": { "type": "string" },
          "designRef": { "type": "string", "description": "Where the design defines this resource" },
          "dependsOn": { "type": "array", "items": { "type": "string", "pattern": "^R-[0-9]{3,}$" } },
          "settings": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/rawField" } }
        }
      }
    }
  },
  "$defs": {
    "rawField": {
      "type": "object",
      "required": ["raw", "sources"],
      "additionalProperties": false,
      "properties": {
        "raw": { "type": ["string", "null"] },
        "sources": { "type": "array", "items": { "type": "string", "pattern": "^P-[0-9]{3,}$" } },
        "note": { "type": "string" }
      }
    }
  }
}
